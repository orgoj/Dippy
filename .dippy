# Dippy config for Dippy

include .dippy-yolo

#---- Python ----#
allow rm -rf /**/__pycache__

#deny uv run ruff * "Use `just fmt --fix` and `just lint --fix`"
deny .venv/bin/*  "Use `uv`"
deny .venv/bin/* *  "Use `uv`"
# deny pytest run  "Use: uv run python -m pytest ..."
# deny pytest run *  "Use: uv run python -m pytest ..."
deny python * "Use `uv run python`"
deny python3 * "Use `uv run python`"
deny python3 -m pytest * "Use: uv run python -m pytest ..."

# deny uv run pytest *  "Use: uv run python -m pytest ..."
# deny uv run python *  "Use: uv run python -m pytest ..."
allow uv run python -m pytest *
allow uv run python ./*

allow pytest run *

allow DIPPY_CONFIG=$CONF PYTHONPATH=src python3 -m dippy.dippy *


#---- Just ----#
allow just *
# allow just check *
# allow just fmt *
# allow just lint *
# allow just test *
deny just -C "Don't use -C, use the target directly"

allow ruff *

#deny git worktree add * "Use relative path: git worktree add .worktrees/..."
#allow git worktree add .worktrees/**
allow git add *
