# Dippy config for Dippy

include .dippy-yolo

allow cargo *
allow rustup show *
allow **/parity/run *
allow tsc *

# Locally built Dippy binaries (same trust as `allow dippy *` in .dippy-yolo)
allow ./rust/target/release/dippy-rs *
allow ./rust/target/debug/dippy-rs *
allow ./.venv-3.12/bin/dippy *

# 1-3 paths, each inside tmp/; `allow rm tmp/*` also matched `rm tmp/x /etc/passwd`
allow [opts: -r, -f] rm tmp/*
allow [opts: -r, -f] rm tmp/* tmp/*
allow [opts: -r, -f] rm tmp/* tmp/* tmp/*

#---- File Operations ----#
allow-read ./**
allow-edit ./**
allow-read ~/.dippy/audit.log

allow-redirect tmp/**

# Safe reading of rule files for analysis (editing remains protected by global ask-edit)
allow-read .dippy*
allow-read **/.dippy*

#---- Python ----#
allow rm -rf /**/__pycache__

#deny uv run ruff * "Use `just fmt --fix` and `just lint --fix`"
deny .venv/bin/*  "Use `uv`"
deny .venv/bin/* *  "Use `uv`"
# deny pytest run  "Use: uv run python -m pytest ..."
# deny pytest run *  "Use: uv run python -m pytest ..."
deny python * "Use `uv run python`"
deny python3 * "Use `uv run python`"
deny python3 -m pytest * "Use: uv run python -m pytest ..."

# deny uv run pytest *  "Use: uv run python -m pytest ..."
# deny uv run python *  "Use: uv run python -m pytest ..."
allow uv run python -m pytest *
allow uv run python ./*

allow pytest run *

allow ./scripts/debug/try-rules.sh *

allow DIPPY_CONFIG=$CONF PYTHONPATH=src python3 -m dippy.dippy *
allow PYTHONPATH=src python3 ./scripts/debug/check-rule.py *


#---- Just ----#
allow just *
# allow just check *
# allow just fmt *
# allow just lint *
# allow just test *
deny just -C "Don't use -C, use the target directly"

allow ruff *

#deny git worktree add * "Use relative path: git worktree add .worktrees/..."
#allow git worktree add .worktrees/**
allow git add *
allow git commit *
allow git checkout -- *

#---- Agent context reproduction ----#
# Rules are verified against the context flags of the agent being analysed, so
# this variable has to be set before calling dippy. It only feeds
# `set context-env HCOM_INSTANCE_NAME`; it changes nothing outside Dippy.
allow export HCOM_INSTANCE_NAME=*
allow HCOM_INSTANCE_NAME=* dippy *
allow HCOM_INSTANCE_NAME=* ./scripts/debug/try-rules.sh *

#---- dippy_dev bundle ----#
# Exact paths, scoped to dippy_dev; SOUL.md edits stay on ask.
set context-env HCOM_INSTANCE_NAME
allow-redirect [$HCOM_INSTANCE_NAME=dippy_dev] ~/.hcom/agents/dippy_dev/TODO.md
allow-read [$HCOM_INSTANCE_NAME=dippy_dev] ~/.hcom/agents/dippy_dev/**
allow-edit [$HCOM_INSTANCE_NAME=dippy_dev] ~/.hcom/agents/dippy_dev/NOTES.md
allow-edit [$HCOM_INSTANCE_NAME=dippy_dev] ~/.hcom/agents/dippy_dev/TODO.md

#---- hcom ----#
allow [$HCOM_INSTANCE_NAME=dippy_dev] hcom send @* --name dippy_dev *
