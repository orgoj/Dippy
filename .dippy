# Dippy config for Dippy

include .dippy-yolo

allow ./bin/dippy-hook *

#---- Python ----#
allow rm -rf /**/__pycache__
#deny python3 * "Use `uv run python`"
#deny python * "Use `uv run python`"
#deny uv run ruff * "Use `just fmt --fix` and `just lint --fix`"
allow uv run python -c *

allow uv run python -m pytest *
allow uv run python *
allow uv run pytest *
allow pytest run *
allow pytest run

deny .venv/bin/*

#---- Just ----#
allow just check *
allow just fmt *
allow just lint *
allow just test *
deny just -C "Don't use -C, use the target directly"

#deny git worktree add * "Use relative path: git worktree add .worktrees/..."
#allow git worktree add .worktrees/**

allow git add *
allow ruff *

# for merge yolo
allow git *
allow cc-find /home/michael/work/ai/CLAUDE/TOOLS/dippy-dev *
allow cc-find /home/michael/work/ai/CLAUDE/TOOLS/dippy-dev/** *
