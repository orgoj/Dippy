#!/usr/bin/env python3
"""Run dippy-rs on the parity corpus and write rust/parity/report.md.

Every case runs ``dippy-rs --cmd CMD --json --cwd CWD [--config FILE]`` as a
separate process with the same empty HOME, working directory and config files
the oracle used. Only decisions are compared; reasons may differ.

Exit status: 1 if any unsafe divergence (Rust allow, Python not allow).
Usage: rust/parity/run [--build] [--jobs N]
"""

from __future__ import annotations

import argparse
import collections
import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from parity_env import ROOT, child_env, cli_args, prepare_root  # noqa: E402

BIN = HERE.parent / "target" / "release" / "dippy-rs"
REPORT = HERE / "report.md"


def first_word(cmd: str) -> str:
    words = cmd.strip().split()
    i = 0
    while i < len(words) - 1 and "=" in words[i] and not words[i].startswith("-"):
        i += 1
    return words[i] if words else "(empty)"


def run_case(case: dict, env: dict) -> str:
    proc = subprocess.run(
        [str(BIN), *cli_args(case)],
        capture_output=True,
        text=True,
        env=env,
        cwd=ROOT,
        timeout=30,
    )
    try:
        return json.loads(proc.stdout.splitlines()[0])["decision"]
    except (IndexError, json.JSONDecodeError, KeyError):
        return f"error(exit {proc.returncode})"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--build", action="store_true")
    ap.add_argument("--jobs", type=int, default=os.cpu_count() or 4)
    args = ap.parse_args()
    if args.build:
        subprocess.run(
            ["cargo", "build", "--release", "-q"], cwd=HERE.parent, check=True
        )
    cases = [json.loads(line) for line in (HERE / "corpus.jsonl").read_text().splitlines()]
    prepare_root(cases)
    env = child_env()
    with ThreadPoolExecutor(args.jobs) as pool:
        actual = list(pool.map(lambda c: run_case(c, env), cases))

    total = len(cases)
    agree = sum(1 for c, a in zip(cases, actual) if c["expected"] == a)
    unsafe = [
        (c, a) for c, a in zip(cases, actual) if a == "allow" and c["expected"] != "allow"
    ]
    by_direction = collections.Counter()
    by_word = collections.defaultdict(list)
    for case, got in zip(cases, actual):
        if case["expected"] != got:
            by_direction[f"python {case['expected']} -> rust {got}"] += 1
            by_word[first_word(case["cmd"])].append((case, got))
    by_source = collections.defaultdict(lambda: [0, 0])
    for case, got in zip(cases, actual):
        by_source[case["src"]][0] += 1
        by_source[case["src"]][1] += case["expected"] == got

    lines = [
        "# dippy-rs parity report",
        "",
        "Generated by `rust/parity/run`. Python Dippy (`build_corpus.py` oracle)",
        "vs `dippy-rs`, decisions only.",
        "",
        f"- Cases: {total}",
        f"- Agreement: {agree} ({100 * agree / total:.2f}%)",
        f"- Divergences: {total - agree}",
        f"- **Unsafe divergences (Rust allow, Python not allow): {len(unsafe)}**",
        "",
        "## By corpus source",
        "",
        "| source | cases | agree |",
        "| --- | ---: | ---: |",
    ]
    for src, (n, ok) in sorted(by_source.items()):
        lines.append(f"| {src} | {n} | {ok} ({100 * ok / n:.1f}%) |")
    lines += ["", "## By direction", "", "| direction | cases |", "| --- | ---: |"]
    for key, n in by_direction.most_common():
        lines.append(f"| {key} | {n} |")
    if unsafe:
        lines += ["", "## Unsafe divergences", ""]
        for case, got in unsafe[:100]:
            lines.append(f"- `{json.dumps(case['cmd'])[1:-1][:160]}` (config: {bool(case['config'])})")
    lines += ["", "## By first command word", ""]
    lines += ["| word | divergences | examples |", "| --- | ---: | --- |"]
    for word, items in sorted(by_word.items(), key=lambda kv: -len(kv[1])):
        examples = "; ".join(
            f"`{json.dumps(c['cmd'])[1:-1][:70]}` {c['expected']}->{g}" for c, g in items[:3]
        ).replace("|", "\\|")
        lines.append(f"| `{word[:40]}` | {len(items)} | {examples} |")
    REPORT.write_text("\n".join(lines) + "\n")
    print(
        f"{total} cases, {agree} agree ({100 * agree / total:.2f}%), "
        f"{total - agree} diverge, {len(unsafe)} unsafe"
    )
    for key, n in by_direction.most_common():
        print(f"  {key}: {n}")
    return 1 if unsafe else 0


if __name__ == "__main__":
    sys.exit(main())
